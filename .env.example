# Configuração de Chave de API do Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Modelo Padrão do Google ADK / Gemini
GEMINI_MODEL=gemini-2.5-flash

# Forçar uso do Mock LLM para testes sem API Key (true/false)
USE_MOCK_LLM=false

# Chave de API do TMDB (The Movie Database) usada pelo MovieCatalogAgent
TMDB_API_KEY=your_tmdb_api_key_here
